{
  "logging_level": "DEBUG",

  "brain_llm": {
    "provider": "turix",
    "model_name": "turix-model",
    "api_key": "your_api_key_here",
    "base_url": "https://llm.turixapi.io/v1" 
  },

  "actor_llm": {
    "provider": "turix",
    "model_name": "turix-model",
    "api_key": "your_api_key_here",
    "base_url": "https://llm.turixapi.io/v1" 
  },

  "planner_llm": {
    "provider": "turix",
    "model_name": "turix-model",
    "api_key": "your_api_key_here",
    "base_url": "https://llm.turixapi.io/v1" 
  },

  "screenshot_features_extractor": {
    "img_size": 512,
    "pretrained": true,
    "feature_dim": 768,
    "weight_path": "path-to-weights"
  },

  "embed_llm": {
    "provider": "turix",
    "model_name": "turix-model",
    "api_key": "your_api_key_here",
    "base_url": "https://llm.turixapi.io/v1",
    "max_retries": 3,
    "timeout": 30
  },

  "agent": {
    "task": "用safari去苹果官网帮我找到手机iphone 手机的最新价格信息，用record_info进行记录（型号和价格），然后写成一个pages文档,保存成pdf文件，重命名后保存到桌面 然后用微信发给 pyk",
    "short_memory_len": 5,
    "use_ui": false,
    "max_actions_per_step": 5,
    "max_steps": 100,
    "use_turix": true,
    "save_brain_conversation_path": "brain_llm_interactions.log",
    "save_actor_conversation_path": "actor_llm_interactions.log",
    "save_actor_conversation_path_encoding": "utf-8",
    "save_brain_conversation_path_encoding": "utf-8",
    "knowledge_base_json": "path-to-knowledge-base-json"
  }
}
